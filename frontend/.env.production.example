# Copy to frontend/.env.production on the deploy target. Vite compiles every
# VITE_* value into the browser bundle, so only ever put public values here.

VITE_API_BASE_URL=https://zicab.in/api/v1
VITE_BACKEND_ORIGIN=https://zicab.in
VITE_SOCKET_URL=https://zicab.in

# Firebase web push. All of these are public by design — the web SDK config ships
# in every client and is protected by Firebase security rules and the authorised
# domains list, not by secrecy.
#
# VITE_FIREBASE_VAPID_KEY is the *public* half of the Web Push key pair
# (Firebase Console -> Project settings -> Cloud Messaging -> Web Push
# certificates). The private half is never used by the client; do not put it in
# any VITE_* variable.
#
# Without all seven of these, registerBrowserFcmToken() returns
# reason: 'firebase-web-config-missing' and web push silently does nothing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
